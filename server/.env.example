# ActionFlow AI — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Gemini AI ─────────────────────────────────────────────────────────────────
# Get your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_MS=15000
GEMINI_MAX_RETRIES=3

# ─── Redis (optional — falls back to in-memory if not set) ─────────────────────
REDIS_URL=redis://localhost:6379
REDIS_CACHE_TTL_SECONDS=300

# ─── WhatsApp (optional) ────────────────────────────────────────────────────────
# Twilio WhatsApp Sandbox or Business API credentials
WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ─── Google Calendar (optional) ─────────────────────────────────────────────────
GOOGLE_CALENDAR_CLIENT_ID=your_google_client_id
GOOGLE_CALENDAR_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# ─── Security ──────────────────────────────────────────────────────────────────
API_SECRET_KEY=change_this_to_a_long_random_secret_in_production
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ─── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
